<!-- Additional classic routes; handheld LCD tuning remains pending. -->
<system>
  <name>nes</name><fullname>Nintendo Entertainment System</fullname>
  <path>%ROMPATH%/nes</path>
  <extension>.nes .NES .unf .UNF .unif .UNIF .zip .ZIP .7z .7Z</extension>
  <command label="Mesen (CRT)">%EMULATOR_RETROARCH% --presentation crt -L %CORE_RETROARCH%/mesen_libretro.so %ROM%</command>
  <command label="Mesen (Unfiltered)">%EMULATOR_RETROARCH% --presentation raw -L %CORE_RETROARCH%/mesen_libretro.so %ROM%</command>
  <platform>nes</platform><theme>nes</theme>
</system>
